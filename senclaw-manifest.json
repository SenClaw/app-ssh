{
  "id": "ssh-manager",
  "name": "SSH Manager",
  "description": "Standalone SSH Manager App Space for SenClaw. Provides web terminal and secure command execution.",
  "icon": "S",
  "runtime": {
    "kind": "server",
    "mode": "background",
    "start": "./ssh-manager",
    "healthPath": "/"
  },
  "integration": {
    "type": "iframe",
    "url": "/"
  },
  "bridge": {
    "postMessage": true,
    "capabilities": ["space.rest"]
  },
  "mcp": {
    "name": "ssh-manager-mcp",
    "transport": "http",
    "path": "/api/mcp/sse",
    "description": "SSH Manager MCP: quản lý host, mở kết nối SSH có trạng thái và chạy lệnh từ xa, thao tác file qua SFTP, và mở/đóng/kiểm tra tunnel port forwarding (ssh -L) với trạng thái thật (đang forward, lỗi gì, bao nhiêu kết nối). Lệnh chỉ đọc chạy ngay; lệnh nguy hiểm chờ admin duyệt (ssh_command_status đọc kết quả); lệnh lạ được AI và System One kiểm tra.",
    "autoRegister": true
  },
  "skills": [
    {
      "name": "ssh-port-forward",
      "path": "skills/ssh-port-forward",
      "triggers": [
        "port forwarding",
        "port forward",
        "mở port forwarding",
        "đóng port forwarding",
        "mở tunnel",
        "đóng tunnel",
        "tunnel ssh",
        "kiểm tra tunnel",
        "forward cổng",
        "ssh -L",
        "open tunnel",
        "close tunnel",
        "tunnel status"
      ]
    },
    {
      "name": "ssh-reporting",
      "path": "skills/ssh-reporting",
      "triggers": ["báo cáo ssh", "ssh report", "thống kê server"]
    },
    {
      "name": "ssh-guide",
      "path": "skills/ssh-guide",
      "triggers": ["hướng dẫn ssh", "ssh guide", "cách dùng ssh"]
    },
    {
      "name": "ssh-connect",
      "path": "skills/ssh-connect",
      "triggers": ["kết nối ssh", "connect ssh", "thực hiện lệnh", "vào server"]
    }
  ],
  "sync": {
    "version": 1,
    "endpoint": "/api/sync",
    "order": ["keychain", "hosts", "port_forwarding", "snippets"],
    "collections": [
      {
        "id": "keychain",
        "schemaVersion": 1,
        "secretFields": ["value"],
        "localFields": [],
        "matchKey": ["name", "item_type"],
        "guardFields": [],
        "refs": []
      },
      {
        "id": "hosts",
        "schemaVersion": 1,
        "secretFields": ["password"],
        "localFields": [],
        "matchKey": ["host", "port", "user"],
        "guardFields": ["host", "port", "user", "keychain_id"],
        "refs": [{ "field": "keychain_id", "target": "keychain" }]
      },
      {
        "id": "port_forwarding",
        "schemaVersion": 1,
        "secretFields": [],
        "localFields": ["active"],
        "matchKey": ["host_id", "local_port", "destination_address", "destination_port"],
        "guardFields": [],
        "refs": [{ "field": "host_id", "target": "hosts" }]
      },
      {
        "id": "snippets",
        "schemaVersion": 1,
        "secretFields": [],
        "localFields": [],
        "matchKey": ["name"],
        "guardFields": [],
        "refs": []
      }
    ]
  }
}
