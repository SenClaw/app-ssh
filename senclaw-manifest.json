{
  "id": "ssh-manager",
  "name": "SSH Manager",
  "description": "Standalone SSH Manager App Space for SenClaw. Provides web terminal and secure command execution.",
  "icon": "S",
  "runtime": {
    "kind": "server",
    "mode": "background",
    "start": "./ssh-manager",
    "healthPath": "/"
  },
  "integration": {
    "type": "iframe",
    "url": "/"
  },
  "bridge": {
    "postMessage": true,
    "capabilities": ["space.rest"]
  },
  "mcp": {
    "name": "ssh-manager-mcp",
    "transport": "http",
    "path": "/api/mcp/sse",
    "description": "SSH Manager MCP: quản lý host, mở kết nối SSH có trạng thái và chạy lệnh từ xa, thao tác file qua SFTP, và mở/đóng/kiểm tra tunnel port forwarding (ssh -L) với trạng thái thật (đang forward, lỗi gì, bao nhiêu kết nối).",
    "autoRegister": true
  },
  "skills": [
    {
      "name": "ssh-port-forward",
      "path": "skills/ssh-port-forward",
      "triggers": [
        "port forwarding",
        "port forward",
        "mở port forwarding",
        "đóng port forwarding",
        "mở tunnel",
        "đóng tunnel",
        "tunnel ssh",
        "kiểm tra tunnel",
        "forward cổng",
        "ssh -L",
        "open tunnel",
        "close tunnel",
        "tunnel status"
      ]
    },
    {
      "name": "ssh-reporting",
      "path": "skills/ssh-reporting",
      "triggers": ["báo cáo ssh", "ssh report", "thống kê server"]
    },
    {
      "name": "ssh-guide",
      "path": "skills/ssh-guide",
      "triggers": ["hướng dẫn ssh", "ssh guide", "cách dùng ssh"]
    },
    {
      "name": "ssh-connect",
      "path": "skills/ssh-connect",
      "triggers": ["kết nối ssh", "connect ssh", "thực hiện lệnh", "vào server"]
    }
  ]
}
